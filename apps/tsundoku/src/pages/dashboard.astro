---
export const prerender = false;

import { env } from "cloudflare:workers";
import {
  buildInvitePath,
  GROUP_INVITE_QUERY_PARAM,
  listGroupsForUser,
  listInvitationsForUser,
  recordInvitationFromToken,
} from "../lib/groups";
import {
  loadOwnShelf,
  loadSharedShelves,
  type SharedShelfView,
} from "../lib/shelves";
import { listTransferTargets } from "../lib/shelf-configs";
import { normalizeVisibility, parseGroupIds } from "../lib/shelf-rows";

const { user } = Astro.locals;

// Middleware already gates this route; this is a defensive fallback so the page
// can never render a broken shell if the guard is bypassed.
if (!user) {
  return Astro.redirect("/login?next=%2Fdashboard");
}

// Phase 5: an invite link (`/dashboard?invite=<token>`) records the invitation
// for the signed-in user, then normalizes the URL so a refresh does not repeat
// the write. An unknown or rotated token is ignored without leaking any group
// details (it simply records nothing).
const inviteToken = Astro.url.searchParams.get(GROUP_INVITE_QUERY_PARAM);
if (inviteToken) {
  try {
    await recordInvitationFromToken(env.DB, {
      userId: user.id,
      token: inviteToken,
    });
  } catch {
    // A missing table (unapplied migration) or transient D1 error must not break
    // the dashboard; the invite is simply not recorded this time.
  }
  return Astro.redirect("/dashboard");
}

// My Shelf + every shared shelf are resolved on the server. Shared shelves are
// isolated per-shelf inside `loadSharedShelves`, so one owner's revoked token
// never takes down the dashboard. Eligible transfer recipients are resolved for
// the own-shelf only (shared shelves stay read-only). Groups and the invitation
// inbox back Phase 5's three-level visibility model.
//
// Every loader is failure-isolated: a missing table (e.g. an unapplied D1
// migration) or a transient D1/Google error degrades one panel to an empty or
// error state instead of returning a 500 for the whole page.
async function safeLoad<T>(promise: Promise<T>, fallback: T): Promise<T> {
  try {
    return await promise;
  } catch {
    return fallback;
  }
}

const [ownShelf, sharedShelves, transferTargets, groups, invitations] =
  await Promise.all([
    loadOwnShelf(env, user.id),
    loadSharedShelves(env, user.id),
    safeLoad(listTransferTargets(env.DB, user.id), []),
    safeLoad(listGroupsForUser(env.DB, user.id), []),
    safeLoad(listInvitationsForUser(env.DB, user.id), []),
  ]);

const pendingInvitations = invitations.filter(
  (invite) => invite.status === "pending",
);
const ignoredInvitations = invitations.filter(
  (invite) => invite.status === "ignored",
);

/** Resolve a row's comma-separated group ids to display names for the UI. */
const groupNameById = new Map(groups.map((group) => [group.id, group.name]));

const ownSpreadsheetUrl = ownShelf.spreadsheetId
  ? `https://docs.google.com/spreadsheets/d/${ownShelf.spreadsheetId}`
  : null;
// Human-readable label (live title when available) while `spreadsheet_id` stays
// the internal identifier used for every read/write.
const ownLabel =
  ownShelf.spreadsheetId && ownShelf.sheetTabName
    ? `${ownShelf.title ?? ownShelf.spreadsheetId} (tab: ${ownShelf.sheetTabName})`
    : null;
const ownHasRows = ownShelf.status === "ok" && ownShelf.rows.length > 0;

interface ShelfTab {
  id: string;
  label: string;
  meta: string;
  /** Shared tabs carry the viewer/owner common active group ids (Phase 5). */
  groups?: string;
}

const tabs: ShelfTab[] = [
  { id: "own", label: "My Shelf", meta: user.email },
  ...sharedShelves.map((shelf) => ({
    id: `shared:${shelf.ownerId}`,
    label: shelf.ownerName || shelf.ownerEmail,
    meta: shelf.ownerEmail,
    groups: shelf.groupIds.join(","),
  })),
];

function sharedUrl(shelf: SharedShelfView): string {
  return `https://docs.google.com/spreadsheets/d/${shelf.spreadsheetId}`;
}

function sharedLabel(shelf: SharedShelfView): string {
  return `${shelf.title ?? shelf.spreadsheetId} (tab: ${shelf.sheetTabName})`;
}

function addedDate(value: string): string {
  return value ? value.slice(0, 10) : "—";
}

/** Render a row's targeted groups as names (falling back to the raw id). */
function groupLabels(value: string): string {
  const ids = parseGroupIds(value);
  if (ids.length === 0) return "—";
  return ids.map((id) => groupNameById.get(id) ?? id).join(", ");
}

/**
 * Level-3 inherited values for another member's row: a book's assigned groups
 * restricted to the active groups its owner shares with the viewer. Only groups
 * the viewer already belongs to are ever shown, so no foreign group name or id
 * leaks into the DOM.
 */
function inheritedGroupIds(rowGroups: string, commonGroupIds: string[]): string[] {
  const common = new Set(commonGroupIds);
  return parseGroupIds(rowGroups).filter((id) => common.has(id));
}

function inheritedGroupLabels(rowGroups: string, commonGroupIds: string[]): string {
  const ids = inheritedGroupIds(rowGroups, commonGroupIds);
  if (ids.length === 0) return "—";
  return ids.map((id) => groupNameById.get(id) ?? id).join(", ");
}

/** Absolute invite link an admin can share (token is opaque and rotatable). */
function inviteUrl(token: string): string {
  return new URL(buildInvitePath(token), Astro.url.origin).toString();
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Dashboard — Tsundoku</title>
  </head>
  <body>
    <main class="app" data-user-id={user.id} data-shared-filter-pending>
      <header class="header">
        <div>
          <h1>Dashboard</h1>
          <p class="subtitle">Signed in as {user.email}</p>
        </div>
        <div class="controls">
          <a class="button" href="/settings">Shelf settings</a>
          <a class="button" href="/">Scan a book</a>
          <button type="button" id="sign-out">Sign out</button>
        </div>
      </header>

      <!-- Invitation inbox (Phase 5) -->
      <section class="panel" id="invitations-panel" aria-label="Invitations">
        <div class="shelf-head">
          <h2>Invitations</h2>
          <span id="invite-count" class="badge" data-count={pendingInvitations.length}>
            {pendingInvitations.length} pending
          </span>
        </div>
        <p class="muted">
          Invitations to join a group. Accept to start sharing with its members,
          or ignore to keep it out of the way.
        </p>
        <p id="invitation-status" class="status" data-tone="error" role="status" hidden />
        <ul id="invitation-list" class="invite-list">
          {
            pendingInvitations.map((invite) => (
              <li class="invite-item" data-invitation-id={invite.id}>
                <span>
                  <strong>{invite.groupName}</strong>
                  {" — invited by "}
                  {invite.inviterEmail ?? "a group admin"}
                </span>
                <span class="controls">
                  <button type="button" data-action="accept-invite">Accept</button>
                  <button type="button" data-action="ignore-invite">Ignore</button>
                  <button type="button" data-action="remove-invite">Remove</button>
                </span>
              </li>
            ))
          }
        </ul>
        <p id="invitation-empty" class="muted" hidden={pendingInvitations.length > 0}>
          No pending invitations.
        </p>
        <details id="ignored-invitations" hidden={ignoredInvitations.length === 0}>
          <summary>Ignored ({ignoredInvitations.length})</summary>
          <ul class="invite-list">
            {
              ignoredInvitations.map((invite) => (
                <li class="invite-item" data-invitation-id={invite.id}>
                  <span>
                    <strong>{invite.groupName}</strong>
                    {" — invited by "}
                    {invite.inviterEmail ?? "a group admin"}
                  </span>
                  <span class="controls">
                    <button type="button" data-action="accept-invite">Accept</button>
                    <button type="button" data-action="remove-invite">Remove</button>
                  </span>
                </li>
              ))
            }
          </ul>
        </details>
      </section>

      <!-- Groups (Phase 5) -->
      <section class="panel" id="groups-panel" aria-label="Your groups">
        <div class="shelf-head">
          <h2>Your groups</h2>
        </div>
        <p class="muted">
          Sharing and transfers are limited to people in your groups. Create a
          group, then share its invite link.
        </p>
        <form id="create-group-form" autocomplete="off">
          <label class="inline-label">
            New group name
            <input name="name" maxlength="80" placeholder="Book club" />
          </label>
          <button type="submit" id="create-group-button">Create group</button>
        </form>
        <p id="group-status" class="status" data-tone="error" role="status" hidden />
        <p id="group-empty" class="muted" hidden={groups.length > 0}>
          You are not in any group yet. Create one to start sharing.
        </p>
        <ul id="group-list" class="group-list">
          {
            groups.map((group) => (
              <li class="group-item" data-group-id={group.id}>
                <div class="group-head">
                  <strong>{group.name}</strong>
                  <span class="badge">{group.role}</span>
                  <span class="muted">
                    {group.memberCount} {group.memberCount === 1 ? "member" : "members"}
                  </span>
                </div>
                {group.isAdmin && group.inviteToken ? (
                  <div class="invite-controls">
                    <input
                      type="text"
                      readonly
                      class="invite-link"
                      data-invite-link
                      value={inviteUrl(group.inviteToken)}
                    />
                    <button type="button" data-action="copy-invite">Copy link</button>
                    <button type="button" data-action="rotate-invite">Regenerate</button>
                  </div>
                ) : (
                  <p class="muted">Only this group's admin can hand out invites.</p>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Shared-shelf group filter (Phase 5) -->
      {
        groups.length > 0 && sharedShelves.length > 0 && (
          <section class="panel" id="shared-filter" aria-label="Filter shared shelves">
            <div class="shelf-head">
              <h2>Shared shelves</h2>
              <button type="button" id="filter-clear" class="link">
                Show all groups
              </button>
            </div>
            <p class="muted">
              Google sheets are shared within the groups you belong to. Actual
              book visibility for sharing depends on the individual setting of
              the book. Tick groups to filter what is shown.
            </p>
            <div class="filter-options">
              {groups.map((group) => (
                <label class="check">
                  <input type="checkbox" name="groupFilter" value={group.id} />
                  <span>{group.name}</span>
                </label>
              ))}
            </div>
          </section>
        )
      }

      <nav class="tabs" role="tablist" aria-label="Shelves">
        {
          tabs.map((tab, index) => (
            <button
              type="button"
              class={index === 0 ? "tab active" : "tab"}
              role="tab"
              data-shelf-tab={tab.id}
              data-groups={tab.groups}
              aria-selected={index === 0 ? "true" : "false"}
            >
              <span class="tab-label">{tab.label}</span>
              <span class="tab-meta">{tab.meta}</span>
            </button>
          ))
        }
      </nav>

      {
        sharedShelves.length === 0 && (
          <p id="no-shared-message" class="muted">
            No shared shelves are available yet. When another reader publishes
            books, their shelf appears here as a read-only tab.
          </p>
        )
      }

      <p id="shared-filter-empty" class="muted" hidden>
        No shared shelves match the selected groups.
      </p>

      <!-- My Shelf (OWNER) -->
      <section
        class="panel shelf-panel"
        role="tabpanel"
        data-shelf-panel="own"
        aria-label="My shelf"
      >
        <div class="shelf-head">
          <h2>My Shelf</h2>
          {
            ownShelf.status === "ok" && (
              <span id="own-count" class="badge" data-count={ownShelf.rows.length}>
                {ownShelf.rows.length} {ownShelf.rows.length === 1 ? "book" : "books"}
              </span>
            )
          }
        </div>

        {
          ownLabel && ownSpreadsheetUrl && (
            <p class="muted">
              Linked sheet:{" "}
              <a href={ownSpreadsheetUrl} target="_blank" rel="noreferrer">
                {ownLabel}
              </a>
            </p>
          )
        }

        <p id="own-status" class="status" data-tone="error" role="status" hidden />

        {
          ownShelf.status === "not_connected" && (
            <div class="state">
              <p class="muted">
                No Google account is connected, so there is no personal shelf to
                show yet.
              </p>
              <a class="button" href="/settings">Connect Google account</a>
            </div>
          )
        }

        {
          ownShelf.status === "unlinked" && (
            <div class="state">
              <p class="muted">
                Your Google account is connected, but no spreadsheet is linked.
                Create a new sheet in one click, or pick an existing one.
              </p>
              <a class="button" href="/settings">Create or link a sheet</a>
            </div>
          )
        }

        {
          ownShelf.status === "error" && (
            <div class="state">
              <p class="muted">{ownShelf.message}</p>
              <a class="button" href="/settings">Reconnect / re-pick the sheet</a>
            </div>
          )
        }

        {
          ownShelf.spreadsheetId && (
            <div
              class="sheet-visibility"
              data-sheet-visibility-control
              data-visibility={ownShelf.sheetVisibility}
            >
              <div class="sheet-visibility-head">
                <span class="muted">Sheet visibility</span>
                <div class="segmented" role="group" aria-label="Sheet visibility">
                  <button
                    type="button"
                    class={ownShelf.sheetVisibility === "private" ? "seg-item active" : "seg-item"}
                    data-set-sheet-visibility="private"
                    aria-pressed={ownShelf.sheetVisibility === "private"}
                  >
                    Private
                  </button>
                  <button
                    type="button"
                    class={ownShelf.sheetVisibility === "shared" ? "seg-item active" : "seg-item"}
                    data-set-sheet-visibility="shared"
                    aria-pressed={ownShelf.sheetVisibility === "shared"}
                  >
                    Shared
                  </button>
                </div>
              </div>
              <p class="muted">
                Controls whether co-members see this whole sheet on their Shared
                Shelves. When shared, individual books still follow each book's
                own visibility and group tags; the "Default visibility for new
                books" setting only affects newly scanned books.
              </p>
              <p
                id="sheet-visibility-status"
                class="status"
                data-tone="success"
                role="status"
                hidden
              />
            </div>
          )
        }

        {
          ownHasRows && (
            <div id="own-table" class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Authors</th>
                    <th scope="col">ISBN13</th>
                    <th scope="col">Publisher</th>
                    <th scope="col">Year</th>
                    <th scope="col">Visibility</th>
                    <th scope="col">Groups</th>
                    <th scope="col">Added</th>
                    <th scope="col"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody>
                  {ownShelf.rows.map((row) => (
                    <tr data-row-index={row.rowIndex} data-row={JSON.stringify(row)}>
                      <td data-cell="title">{row.title || "—"}</td>
                      <td data-cell="authors">{row.authors || "—"}</td>
                      <td data-cell="isbn13" class="mono">{row.isbn13 || "—"}</td>
                      <td data-cell="publisher">{row.publisher || "—"}</td>
                      <td data-cell="publishedYear">{row.publishedYear || "—"}</td>
                      <td data-cell="visibility">
                        <span class="badge" data-visibility={normalizeVisibility(row.visibility)}>
                          {normalizeVisibility(row.visibility)}
                        </span>
                      </td>
                      <td data-cell="groups" class="muted">{groupLabels(row.groups)}</td>
                      <td data-cell="addedAt" class="muted">{addedDate(row.addedAt)}</td>
                      <td class="row-actions">
                        <button type="button" data-action="edit">Edit</button>
                        {
                          transferTargets.length > 0 && (
                            <button type="button" data-action="transfer">
                              Transfer
                            </button>
                          )
                        }
                        <button type="button" data-action="delete">Delete</button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }

        {
          ownShelf.status === "ok" && ownShelf.rows.length === 0 && (
            <p id="own-empty" class="muted">
              Your shelf is empty. Scan a book to add your first entry.
            </p>
          )
        }
      </section>

      <!-- Shared Shelves (VIEWER, read-only) -->
      {
        sharedShelves.map((shelf) => {
          const url = sharedUrl(shelf);
          const id = `shared:${shelf.ownerId}`;
          return (
            <section
              class="panel shelf-panel"
              role="tabpanel"
              data-shelf-panel={id}
              data-groups={shelf.groupIds.join(",")}
              aria-label={`Shared shelf from ${shelf.ownerName || shelf.ownerEmail}`}
              hidden
            >
              <div class="shelf-head">
                <h2>{shelf.ownerName || shelf.ownerEmail}</h2>
                <span class="badge read-only">Read-only</span>
              </div>
              <p class="muted">
                Shared sheet:{" "}
                <a href={url} target="_blank" rel="noreferrer">
                  {sharedLabel(shelf)}
                </a>
              </p>

              {shelf.status === "error" ? (
                <p class="status" data-tone="error" role="status">
                  {shelf.message}
                </p>
              ) : shelf.rows.length === 0 ? (
                <p class="muted">This shelf has no shared books right now.</p>
              ) : (
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Authors</th>
                        <th scope="col">ISBN13</th>
                        <th scope="col">Publisher</th>
                        <th scope="col">Year</th>
                        <th scope="col">Visibility</th>
                        <th scope="col">Groups</th>
                        <th scope="col">Added</th>
                      </tr>
                    </thead>
                    <tbody>
                      {shelf.rows.map((row) => (
                        <tr
                          data-shared-row
                          data-groups={inheritedGroupIds(row.groups, shelf.groupIds).join(",")}
                        >
                          <td>{row.title || "—"}</td>
                          <td>{row.authors || "—"}</td>
                          <td class="mono">{row.isbn13 || "—"}</td>
                          <td>{row.publisher || "—"}</td>
                          <td>{row.publishedYear || "—"}</td>
                          <td>
                            <span class="badge" data-visibility={normalizeVisibility(row.visibility)}>
                              {normalizeVisibility(row.visibility)}
                            </span>
                          </td>
                          <td class="muted">{inheritedGroupLabels(row.groups, shelf.groupIds)}</td>
                          <td class="muted">{addedDate(row.addedAt)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              <p class="muted" data-filter-empty hidden>
                No books in this shelf match the selected groups.
              </p>
            </section>
          );
        })
      }
    </main>

    <dialog id="edit-dialog" aria-label="Edit book">
      <form id="edit-form" method="dialog">
        <h2>Edit book</h2>
        <input type="hidden" name="rowIndex" />
        <label>Title <input name="title" maxlength="500" autocomplete="off" /></label>
        <label>Authors <input name="authors" maxlength="1000" autocomplete="off" /></label>
        <label>Publisher <input name="publisher" maxlength="500" autocomplete="off" /></label>
        <label>Published year <input name="publishedYear" maxlength="20" autocomplete="off" /></label>
        <label>Summary <textarea name="summary" rows="4" maxlength="5000"></textarea></label>
        <label>
          Visibility
          <select name="visibility">
            <option value="private">private</option>
            <option value="shared">shared</option>
          </select>
        </label>
        <fieldset class="group-fieldset">
          <legend>Shared with groups</legend>
          {
            groups.length === 0 ? (
              <p class="muted">
                You are not in any group yet. Create one to share this row.
              </p>
            ) : (
              groups.map((group) => (
                <label class="check">
                  <input
                    type="checkbox"
                    name="rowGroups"
                    value={group.id}
                    data-group-name={group.name}
                  />
                  <span>{group.name}</span>
                </label>
              ))
            )
          }
        </fieldset>
        <p id="edit-status" class="status" data-tone="error" role="status" hidden />
        <div class="controls">
          <button type="submit" id="edit-save">Save changes</button>
          <button type="button" id="edit-cancel">Cancel</button>
        </div>
      </form>
    </dialog>

    {
      transferTargets.length > 0 && (
        <dialog id="transfer-dialog" aria-label="Transfer book">
          <form id="transfer-form" method="dialog">
            <h2>Transfer book</h2>
            <input type="hidden" name="rowIndex" />
            <p class="muted">
              Giving <strong id="transfer-book">this book</strong> to another reader.
            </p>
            <label>
              New owner
              <select name="targetUserId">
                {transferTargets.map((target) => (
                  <option value={target.userId}>
                    {target.name ? `${target.name} (${target.email})` : target.email}
                  </option>
                ))}
              </select>
            </label>
            <p class="muted">
              The book is added to the recipient's shelf first, then removed from
              yours. If the copy fails, your shelf is left unchanged.
            </p>
            <p id="transfer-status" class="status" data-tone="error" role="status" hidden />
            <div class="controls">
              <button type="submit" id="transfer-save">Transfer</button>
              <button type="button" id="transfer-cancel">Cancel</button>
            </div>
          </form>
        </dialog>
      )
    }

    <script>
      import { createAuthClient } from "better-auth/client";

      const authClient = createAuthClient();

      const signOutButton = document.getElementById("sign-out") as HTMLButtonElement | null;
      signOutButton?.addEventListener("click", () => {
        if (signOutButton) signOutButton.disabled = true;
        void authClient.signOut().then(() => {
          window.location.href = "/";
        });
      });

      // --- Shelf selector -------------------------------------------------
      const tabButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-shelf-tab]"),
      );

      function activateShelf(id: string): void {
        for (const button of tabButtons) {
          const active = button.dataset.shelfTab === id;
          button.classList.toggle("active", active);
          button.setAttribute("aria-selected", String(active));
        }
        for (const panel of document.querySelectorAll<HTMLElement>("[data-shelf-panel]")) {
          panel.hidden = panel.dataset.shelfPanel !== id;
        }
      }

      for (const button of tabButtons) {
        button.addEventListener("click", () => {
          const id = button.dataset.shelfTab;
          if (id) activateShelf(id);
        });
      }

      // --- Own shelf edit / delete ---------------------------------------
      interface ShelfRowData {
        rowIndex: number;
        isbn13: string;
        title: string;
        authors: string;
        publisher: string;
        publishedYear: string;
        summary: string;
        visibility: string;
        groups: string;
        addedAt: string;
      }

      const dialog = document.getElementById("edit-dialog") as HTMLDialogElement | null;
      const form = document.getElementById("edit-form") as HTMLFormElement | null;
      const editStatus = document.getElementById("edit-status");
      const ownStatus = document.getElementById("own-status");
      const ownTable = document.getElementById("own-table");
      const ownEmpty = document.getElementById("own-empty");
      const rowGroupInputs = Array.from(
        document.querySelectorAll<HTMLInputElement>('input[name="rowGroups"]'),
      );
      const groupFilterInputs = Array.from(
        document.querySelectorAll<HTMLInputElement>('input[name="groupFilter"]'),
      );

      /** group id → display name, read from the rendered row-tagging controls. */
      const groupNameById = new Map(
        rowGroupInputs.map((input) => [
          input.value,
          input.dataset.groupName ?? input.value,
        ]),
      );

      function parseGroupIds(value: string): string[] {
        return value
          .split(",")
          .map((part) => part.trim())
          .filter((part) => part !== "");
      }

      function groupLabels(value: string): string {
        const ids = parseGroupIds(value);
        if (ids.length === 0) return "—";
        return ids.map((id) => groupNameById.get(id) ?? id).join(", ");
      }

      function field(
        name: string,
      ): HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null {
        return (form?.querySelector(`[name="${name}"]`) ??
          null) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
      }

      function showStatus(element: HTMLElement | null, text: string, tone: string): void {
        if (!element) return;
        element.textContent = text;
        element.setAttribute("data-tone", tone);
        element.hidden = false;
      }

      function openEdit(rowElement: HTMLTableRowElement): void {
        if (!dialog || !form) return;
        let row: ShelfRowData;
        try {
          row = JSON.parse(rowElement.dataset.row ?? "{}") as ShelfRowData;
        } catch {
          return;
        }
        const set = (name: string, value: string): void => {
          const element = field(name);
          if (element) element.value = value;
        };
        set("rowIndex", String(row.rowIndex));
        set("title", row.title ?? "");
        set("authors", row.authors ?? "");
        set("publisher", row.publisher ?? "");
        set("publishedYear", row.publishedYear ?? "");
        set("summary", row.summary ?? "");
        set("visibility", row.visibility === "shared" ? "shared" : "private");
        const selectedGroups = new Set(parseGroupIds(row.groups ?? ""));
        for (const input of rowGroupInputs) {
          input.checked = selectedGroups.has(input.value);
        }
        if (editStatus) editStatus.hidden = true;
        dialog.showModal();
      }

      function readField(name: string): string {
        const element = field(name);
        return element ? element.value : "";
      }

      function applyRowUpdate(rowIndex: string, row: ShelfRowData): void {
        const rowElement = document.querySelector<HTMLTableRowElement>(
          `tr[data-row-index="${rowIndex}"]`,
        );
        if (!rowElement) return;
        rowElement.dataset.row = JSON.stringify(row);

        const setCell = (name: string, value: string): void => {
          const cell = rowElement.querySelector<HTMLElement>(`[data-cell="${name}"]`);
          if (cell) cell.textContent = value === "" ? "—" : value;
        };
        setCell("title", row.title ?? "");
        setCell("authors", row.authors ?? "");
        setCell("publisher", row.publisher ?? "");
        setCell("publishedYear", row.publishedYear ?? "");
        setCell("groups", groupLabels(row.groups ?? ""));
        setCell("addedAt", row.addedAt ? row.addedAt.slice(0, 10) : "");

        const badge = rowElement.querySelector<HTMLElement>('[data-cell="visibility"] .badge');
        if (badge) {
          const visibility = row.visibility === "shared" ? "shared" : "private";
          badge.textContent = visibility;
          badge.setAttribute("data-visibility", visibility);
        }
      }

      async function saveEdit(): Promise<void> {
        if (!dialog || !form) return;
        const rowIndex = Number(readField("rowIndex"));
        if (!Number.isInteger(rowIndex) || rowIndex < 2) return;

        const saveButton = document.getElementById("edit-save") as HTMLButtonElement | null;
        if (saveButton) saveButton.disabled = true;
        if (editStatus) editStatus.hidden = true;

        const body = {
          rowIndex,
          fields: {
            title: readField("title"),
            authors: readField("authors"),
            publisher: readField("publisher"),
            publishedYear: readField("publishedYear"),
            summary: readField("summary"),
            visibility: readField("visibility") === "shared" ? "shared" : "private",
            groups: rowGroupInputs
              .filter((input) => input.checked)
              .map((input) => input.value)
              .join(","),
          },
        };

        try {
          const response = await fetch("/api/shelves/own/rows", {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(body),
          });
          const payload = (await response.json().catch(() => null)) as
            | { ok?: boolean; row?: ShelfRowData; message?: string }
            | null;
          if (!response.ok || !payload?.row) {
            showStatus(editStatus, payload?.message ?? "Could not save changes.", "error");
            return;
          }
          applyRowUpdate(String(rowIndex), payload.row);
          dialog.close();
        } catch {
          showStatus(editStatus, "Network error while saving.", "error");
        } finally {
          if (saveButton) saveButton.disabled = false;
        }
      }

      function updateOwnCount(delta: number): void {
        const countElement = document.getElementById("own-count");
        if (countElement) {
          const current = Number(countElement.dataset.count ?? "0");
          const next = Math.max(0, current + delta);
          countElement.dataset.count = String(next);
          countElement.textContent = `${next} ${next === 1 ? "book" : "books"}`;
        }
        const remaining = ownTable?.querySelectorAll("tbody tr").length ?? 0;
        if (ownTable && remaining === 0) {
          ownTable.hidden = true;
          if (ownEmpty) ownEmpty.hidden = false;
        }
      }

      async function deleteRow(rowElement: HTMLTableRowElement): Promise<void> {
        const rowIndex = Number(rowElement.dataset.rowIndex);
        if (!Number.isInteger(rowIndex) || rowIndex < 2) return;
        if (!window.confirm("Delete this book from your shelf?")) return;

        const button = rowElement.querySelector<HTMLButtonElement>('[data-action="delete"]');
        if (button) button.disabled = true;
        if (ownStatus) ownStatus.hidden = true;

        try {
          const response = await fetch("/api/shelves/own/rows", {
            method: "DELETE",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ rowIndex }),
          });
          const payload = (await response.json().catch(() => null)) as
            | { ok?: boolean; message?: string }
            | null;
          if (!response.ok) {
            showStatus(ownStatus, payload?.message ?? "Could not delete that row.", "error");
            if (button) button.disabled = false;
            return;
          }
          rowElement.remove();
          updateOwnCount(-1);
        } catch {
          showStatus(ownStatus, "Network error while deleting.", "error");
          if (button) button.disabled = false;
        }
      }

      // --- Level 2: sheet-level visibility -------------------------------
      const sheetVisibilityControl = document.querySelector<HTMLElement>(
        "[data-sheet-visibility-control]",
      );
      const sheetVisibilityStatus = document.getElementById("sheet-visibility-status");

      async function setSheetVisibility(visibility: string): Promise<void> {
        if (!sheetVisibilityControl) return;
        const buttons = Array.from(
          sheetVisibilityControl.querySelectorAll<HTMLButtonElement>(
            "[data-set-sheet-visibility]",
          ),
        );
        for (const button of buttons) button.disabled = true;
        if (sheetVisibilityStatus) sheetVisibilityStatus.hidden = true;
        try {
          const response = await fetch("/api/shelves/visibility", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ sheetVisibility: visibility }),
          });
          const payload = (await response.json().catch(() => null)) as
            | { ok?: boolean; sheetVisibility?: string; message?: string }
            | null;
          if (!response.ok || !payload?.ok) {
            showStatus(
              sheetVisibilityStatus,
              payload?.message ?? "Could not update sheet visibility.",
              "error",
            );
            return;
          }
          const next = payload.sheetVisibility === "shared" ? "shared" : "private";
          sheetVisibilityControl.dataset.visibility = next;
          for (const button of buttons) {
            const active = button.dataset.setSheetVisibility === next;
            button.classList.toggle("active", active);
            button.setAttribute("aria-pressed", String(active));
          }
          showStatus(
            sheetVisibilityStatus,
            next === "shared"
              ? "Your sheet is now visible to co-members (books still follow each book's own visibility)."
              : "Your sheet is now hidden from co-members.",
            "success",
          );
        } catch {
          showStatus(
            sheetVisibilityStatus,
            "Network error while updating sheet visibility.",
            "error",
          );
        } finally {
          for (const button of buttons) button.disabled = false;
        }
      }

      sheetVisibilityControl?.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
          "[data-set-sheet-visibility]",
        );
        const visibility = button?.dataset.setSheetVisibility;
        if (visibility) void setSheetVisibility(visibility);
      });

      // --- Own shelf transfer --------------------------------------------
      const transferDialog = document.getElementById("transfer-dialog") as HTMLDialogElement | null;
      const transferForm = document.getElementById("transfer-form") as HTMLFormElement | null;
      const transferStatus = document.getElementById("transfer-status");
      const transferBook = document.getElementById("transfer-book");

      function transferField(
        name: string,
      ): HTMLInputElement | HTMLSelectElement | null {
        return (transferForm?.querySelector(`[name="${name}"]`) ??
          null) as HTMLInputElement | HTMLSelectElement | null;
      }

      function openTransfer(rowElement: HTMLTableRowElement): void {
        if (!transferDialog || !transferForm) return;
        let row: ShelfRowData;
        try {
          row = JSON.parse(rowElement.dataset.row ?? "{}") as ShelfRowData;
        } catch {
          return;
        }
        const hidden = transferField("rowIndex");
        if (hidden) hidden.value = String(row.rowIndex);
        if (transferBook) transferBook.textContent = row.title || row.isbn13 || "this book";
        if (transferStatus) transferStatus.hidden = true;
        transferDialog.showModal();
      }

      async function submitTransfer(): Promise<void> {
        if (!transferDialog || !transferForm) return;
        const rowIndex = Number(transferField("rowIndex")?.value ?? "");
        const targetUserId = transferField("targetUserId")?.value ?? "";
        if (!Number.isInteger(rowIndex) || rowIndex < 2 || targetUserId === "") return;
        if (!window.confirm("Transfer this book to the selected reader?")) return;

        const button = document.getElementById("transfer-save") as HTMLButtonElement | null;
        if (button) button.disabled = true;
        if (transferStatus) transferStatus.hidden = true;

        try {
          const response = await fetch("/api/shelves/transfers", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ rowIndex, targetUserId }),
          });
          const payload = (await response.json().catch(() => null)) as
            | { ok?: boolean; removedFromSender?: boolean; warning?: string | null; message?: string }
            | null;
          if (!response.ok || !payload?.ok) {
            showStatus(
              transferStatus,
              payload?.message ?? "Could not transfer that book.",
              "error",
            );
            return;
          }
          transferDialog.close();
          if (payload.removedFromSender) {
            document
              .querySelector<HTMLTableRowElement>(`tr[data-row-index="${rowIndex}"]`)
              ?.remove();
            updateOwnCount(-1);
            showStatus(
              ownStatus,
              "Book transferred. It has been removed from your shelf.",
              "success",
            );
          } else if (payload.warning) {
            // The book is on the recipient's shelf but still on yours (duplicate).
            showStatus(ownStatus, payload.warning, "warning");
          }
        } catch {
          showStatus(transferStatus, "Network error while transferring.", "error");
        } finally {
          if (button) button.disabled = false;
        }
      }

      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        const actionButton = target?.closest<HTMLButtonElement>("[data-action]");
        if (!actionButton) return;
        const rowElement = actionButton.closest<HTMLTableRowElement>("tr[data-row-index]");
        if (!rowElement) return;
        const action = actionButton.dataset.action;
        if (action === "edit") openEdit(rowElement);
        else if (action === "transfer") openTransfer(rowElement);
        else if (action === "delete") void deleteRow(rowElement);
      });

      // --- Phase 5: groups, invitations, group filter --------------------
      function showGroupStatus(text: string, tone: string): void {
        showStatus(document.getElementById("group-status"), text, tone);
      }

      function showInvitationStatus(text: string, tone: string): void {
        showStatus(document.getElementById("invitation-status"), text, tone);
      }

      async function copyText(text: string): Promise<boolean> {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          return false;
        }
      }

      async function createGroup(): Promise<void> {
        const createForm = document.getElementById(
          "create-group-form",
        ) as HTMLFormElement | null;
        const nameInput =
          createForm?.querySelector<HTMLInputElement>('[name="name"]') ?? null;
        const name = nameInput?.value.trim() ?? "";
        if (!name) {
          showGroupStatus("Enter a group name.", "warning");
          return;
        }
        const button = document.getElementById(
          "create-group-button",
        ) as HTMLButtonElement | null;
        if (button) button.disabled = true;
        try {
          const response = await fetch("/api/groups", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ name }),
          });
          const payload = (await response.json().catch(() => null)) as
            | { ok?: boolean; message?: string }
            | null;
          if (!response.ok || !payload?.ok) {
            showGroupStatus(payload?.message ?? "Could not create the group.", "error");
            if (button) button.disabled = false;
            return;
          }
          // A new group adds itself to the group filter and row-tagging controls.
          window.location.reload();
        } catch {
          showGroupStatus("Network error while creating the group.", "error");
          if (button) button.disabled = false;
        }
      }

      async function rotateInvite(groupElement: HTMLElement): Promise<void> {
        const groupId = groupElement.dataset.groupId ?? "";
        if (!groupId) return;
        const button = groupElement.querySelector<HTMLButtonElement>(
          '[data-action="rotate-invite"]',
        );
        if (button) button.disabled = true;
        try {
          const response = await fetch("/api/groups/token", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ groupId }),
          });
          const payload = (await response.json().catch(() => null)) as
            | { ok?: boolean; invitePath?: string; message?: string }
            | null;
          if (!response.ok || !payload?.invitePath) {
            showGroupStatus(
              payload?.message ?? "Could not regenerate the invite link.",
              "error",
            );
            return;
          }
          const linkInput =
            groupElement.querySelector<HTMLInputElement>("[data-invite-link]");
          if (linkInput) {
            linkInput.value = new URL(
              payload.invitePath,
              window.location.origin,
            ).toString();
          }
          showGroupStatus(
            "New invite link generated. The previous link no longer works.",
            "success",
          );
        } catch {
          showGroupStatus("Network error while regenerating the invite link.", "error");
        } finally {
          if (button) button.disabled = false;
        }
      }

      async function respondInvitation(item: HTMLElement, action: string): Promise<void> {
        const invitationId = item.dataset.invitationId ?? "";
        if (!invitationId) return;
        const button = item.querySelector<HTMLButtonElement>(
          `[data-action="${action}-invite"]`,
        );
        if (button) button.disabled = true;
        try {
          const response = await fetch("/api/invitations/respond", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ invitationId, action }),
          });
          const payload = (await response.json().catch(() => null)) as
            | { ok?: boolean; message?: string }
            | null;
          if (!response.ok || !payload?.ok) {
            showInvitationStatus(
              payload?.message ?? "Could not update the invitation.",
              "error",
            );
            if (button) button.disabled = false;
            return;
          }
          // Accepting changes group membership, reshaping shared shelves and the
          // group filter, so re-render the whole dashboard.
          window.location.reload();
        } catch {
          showInvitationStatus("Network error while updating the invitation.", "error");
          if (button) button.disabled = false;
        }
      }

      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        const actionButton = target?.closest<HTMLButtonElement>("[data-action]");
        if (!actionButton) return;
        const action = actionButton.dataset.action;
        if (action === "copy-invite") {
          const groupElement = actionButton.closest<HTMLElement>("[data-group-id]");
          const linkInput =
            groupElement?.querySelector<HTMLInputElement>("[data-invite-link]");
          if (linkInput) {
            void copyText(linkInput.value).then((copied) =>
              showGroupStatus(
                copied ? "Invite link copied." : "Copy failed — select the link manually.",
                copied ? "success" : "warning",
              ),
            );
          }
        } else if (action === "rotate-invite") {
          const groupElement = actionButton.closest<HTMLElement>("[data-group-id]");
          if (groupElement) void rotateInvite(groupElement);
        } else if (
          action === "accept-invite" ||
          action === "ignore-invite" ||
          action === "remove-invite"
        ) {
          const item = actionButton.closest<HTMLElement>("[data-invitation-id]");
          if (item) void respondInvitation(item, action.replace("-invite", ""));
        }
      });

      // --- Shared-shelves group filter ------------------------------------
      // The viewer's checked groups persist across reloads. We store the
      // *unchecked* ids (not the checked ones) so a group the user joins later
      // defaults to checked, while an explicitly unticked group stays unticked.
      const dashboardEl = document.querySelector("main.app") as HTMLElement | null;
      const sharedFilterUserId = dashboardEl?.dataset.userId ?? "";
      const SHARED_FILTER_STORAGE_PREFIX = "tsundoku:sharedFilter:unchecked:";

      /** Read the persisted unchecked group ids, or `null` when never set. */
      function readUncheckedGroups(): Set<string> | null {
        if (!sharedFilterUserId) return null;
        try {
          const raw = window.localStorage.getItem(
            SHARED_FILTER_STORAGE_PREFIX + sharedFilterUserId,
          );
          if (raw === null) return null;
          const parsed: unknown = JSON.parse(raw);
          if (!Array.isArray(parsed)) return null;
          return new Set(
            parsed.filter((value): value is string => typeof value === "string"),
          );
        } catch {
          return null;
        }
      }

      function writeUncheckedGroups(unchecked: Set<string>): void {
        if (!sharedFilterUserId) return;
        try {
          window.localStorage.setItem(
            SHARED_FILTER_STORAGE_PREFIX + sharedFilterUserId,
            JSON.stringify([...unchecked]),
          );
        } catch {
          // Private mode / quota exceeded: the in-memory choice still applies
          // for this session, matching the previous non-persistent behaviour.
        }
      }

      /** Shared shelf tabs carry the viewer/owner common active group ids. */
      const sharedTabButtons = tabButtons.filter((button) =>
        button.dataset.shelfTab?.startsWith("shared:"),
      );

      /**
       * Apply the checked groups to every shared shelf: a sheet is shown only
       * when it shares at least one checked group with the viewer, and within a
       * kept sheet only rows targeting a checked group remain. An all-unchecked
       * filter therefore hides every shared shelf, so unticking a group always
       * removes the sheets that depended solely on it.
       */
      function applyGroupFilter(persist = false): void {
        if (groupFilterInputs.length === 0) {
          // No filter UI (e.g. groups could not be loaded): leave everything shown.
          dashboardEl?.removeAttribute("data-shared-filter-pending");
          return;
        }

        const selected = new Set(
          groupFilterInputs.filter((input) => input.checked).map((input) => input.value),
        );
        if (persist) {
          const unchecked = new Set(
            groupFilterInputs.filter((input) => !input.checked).map((input) => input.value),
          );
          writeUncheckedGroups(unchecked);
        }

        let anyMatch = false;
        for (const tab of sharedTabButtons) {
          const ids = parseGroupIds(tab.dataset.groups ?? "");
          const match = ids.some((id) => selected.has(id));
          tab.hidden = !match;
          if (match) anyMatch = true;
        }

        for (const panel of document.querySelectorAll<HTMLElement>(
          '[data-shelf-panel^="shared:"]',
        )) {
          const rows = Array.from(
            panel.querySelectorAll<HTMLTableRowElement>("tr[data-shared-row]"),
          );
          let visible = 0;
          for (const row of rows) {
            const ids = parseGroupIds(row.dataset.groups ?? "");
            const match = ids.some((id) => selected.has(id));
            row.hidden = !match;
            if (match) visible += 1;
          }
          // Keep the sheet visible with an explicit empty state when it shares a
          // checked group but no individual book matches the filter.
          const empty = panel.querySelector<HTMLElement>("[data-filter-empty]");
          if (empty) empty.hidden = !(rows.length > 0 && visible === 0);
        }

        const activeTab = tabButtons.find((button) => button.classList.contains("active"));
        if (activeTab?.hidden) activateShelf("own");
        const emptyMessage = document.getElementById("shared-filter-empty");
        if (emptyMessage) emptyMessage.hidden = !(sharedTabButtons.length > 0 && !anyMatch);
      }

      // Initialize the checkboxes from storage before revealing the shelf tabs,
      // so a reload restores the exact selection without a flash of the
      // unfiltered set.
      const storedUnchecked = readUncheckedGroups();
      for (const input of groupFilterInputs) {
        input.checked = storedUnchecked ? !storedUnchecked.has(input.value) : true;
      }
      applyGroupFilter();
      dashboardEl?.removeAttribute("data-shared-filter-pending");

      for (const input of groupFilterInputs) {
        input.addEventListener("change", () => applyGroupFilter(true));
      }
      document.getElementById("filter-clear")?.addEventListener("click", () => {
        for (const input of groupFilterInputs) input.checked = true;
        applyGroupFilter(true);
      });

      const createGroupForm = document.getElementById(
        "create-group-form",
      ) as HTMLFormElement | null;
      createGroupForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        void createGroup();
      });

      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        void saveEdit();
      });

      document.getElementById("edit-cancel")?.addEventListener("click", () => {
        dialog?.close();
      });

      transferForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        void submitTransfer();
      });

      document.getElementById("transfer-cancel")?.addEventListener("click", () => {
        transferDialog?.close();
      });
    </script>

    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, sans-serif;
      }

      body {
        margin: 0;
        background: #0f1115;
        color: #f5f6f8;
      }

      [hidden] {
        display: none !important;
      }

      .app {
        max-width: 64rem;
        margin: 0 auto;
        padding: 1.5rem;
        display: grid;
        gap: 1rem;
      }

      .header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      h1 {
        margin: 0;
        font-size: 1.5rem;
      }

      h2 {
        margin: 0;
        font-size: 1rem;
      }

      .subtitle,
      .muted {
        margin: 0;
        opacity: 0.7;
      }

      .tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .tab {
        display: grid;
        gap: 0.1rem;
        text-align: left;
        padding: 0.5rem 0.8rem;
        border-radius: 0.5rem;
        border: 1px solid #3a4150;
        background: #1b1f28;
        color: inherit;
        font: inherit;
        cursor: pointer;
        min-width: 10rem;
      }

      .tab.active {
        border-color: #5b6cff;
        background: #1d2340;
      }

      .tab-label {
        font-weight: 600;
      }

      .tab-meta {
        font-size: 0.75rem;
        opacity: 0.6;
      }

      /* Until the persisted group filter is applied, hide shared shelf tabs so a
         reload never flashes the whole unfiltered set before restoring state. */
      main[data-shared-filter-pending] [data-shelf-tab^="shared:"] {
        visibility: hidden;
      }

      .panel {
        border: 1px solid #2a2f3a;
        border-radius: 0.75rem;
        padding: 1rem;
        display: grid;
        gap: 0.75rem;
      }

      .shelf-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .controls {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .state {
        display: grid;
        gap: 0.75rem;
        justify-items: start;
      }

      .sheet-visibility {
        display: grid;
        gap: 0.5rem;
        padding: 0.6rem 0.75rem;
        border: 1px solid #2a2f3a;
        border-radius: 0.5rem;
      }

      .sheet-visibility-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .segmented {
        display: inline-flex;
        border: 1px solid #3a4150;
        border-radius: 0.5rem;
        overflow: hidden;
      }

      .seg-item {
        border: none;
        border-radius: 0;
        background: transparent;
        padding: 0.35rem 0.8rem;
        font-size: 0.85rem;
      }

      .seg-item + .seg-item {
        border-left: 1px solid #3a4150;
      }

      .seg-item.active {
        background: #1d2340;
        color: #fff;
      }

      .table-wrap {
        overflow-x: auto;
      }

      table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.9rem;
      }

      th,
      td {
        text-align: left;
        padding: 0.5rem 0.6rem;
        border-bottom: 1px solid #2a2f3a;
        vertical-align: top;
      }

      th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        opacity: 0.7;
      }

      tbody tr:last-child td {
        border-bottom: none;
      }

      .row-actions {
        display: flex;
        gap: 0.35rem;
        white-space: nowrap;
      }

      .mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }

      .badge {
        display: inline-block;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        font-size: 0.8rem;
        background: #1b1f28;
      }

      .badge[data-visibility="shared"] {
        background: #12301c;
      }

      .badge[data-visibility="private"] {
        background: #2a2f3a;
      }

      .badge.read-only {
        background: #2a2f3a;
        opacity: 0.8;
      }

      .status {
        margin: 0;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        background: #1b1f28;
      }

      .status[data-tone="warning"] {
        background: #3a2f12;
      }

      .status[data-tone="error"] {
        background: #3a1618;
      }

      .status[data-tone="success"] {
        background: #12301c;
      }

      button,
      .button {
        display: inline-block;
        padding: 0.5rem 0.8rem;
        border-radius: 0.5rem;
        border: 1px solid #3a4150;
        background: #1b1f28;
        color: inherit;
        font: inherit;
        font-size: 0.9rem;
        text-decoration: none;
        cursor: pointer;
      }

      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      dialog {
        border: 1px solid #2a2f3a;
        border-radius: 0.75rem;
        background: #12151c;
        color: inherit;
        padding: 1.25rem;
        width: min(32rem, 92vw);
      }

      dialog::backdrop {
        background: rgba(0, 0, 0, 0.6);
      }

      dialog form {
        display: grid;
        gap: 0.75rem;
      }

      dialog label {
        display: grid;
        gap: 0.25rem;
        font-size: 0.85rem;
      }

      dialog input,
      dialog textarea,
      dialog select {
        padding: 0.5rem 0.6rem;
        border-radius: 0.5rem;
        border: 1px solid #3a4150;
        background: #1b1f28;
        color: inherit;
        font: inherit;
      }

      .link {
        border: none;
        background: none;
        padding: 0;
        color: #7aa2f7;
        text-decoration: underline;
      }

      .invite-list,
      .group-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
      }

      .invite-item,
      .group-item {
        display: grid;
        gap: 0.5rem;
        padding: 0.6rem 0.75rem;
        border: 1px solid #2a2f3a;
        border-radius: 0.5rem;
      }

      .invite-item {
        grid-template-columns: 1fr auto;
        align-items: center;
      }

      .group-head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .invite-controls {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        align-items: center;
      }

      .invite-link {
        flex: 1 1 16rem;
        padding: 0.5rem 0.6rem;
        border-radius: 0.5rem;
        border: 1px solid #3a4150;
        background: #1b1f28;
        color: inherit;
        font: inherit;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8rem;
      }

      .filter-options,
      .group-fieldset {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
      }

      .group-fieldset {
        border: 1px solid #2a2f3a;
        border-radius: 0.5rem;
        padding: 0.5rem 0.75rem;
      }

      .group-fieldset legend {
        font-size: 0.85rem;
        padding: 0 0.35rem;
      }

      .check {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85rem;
      }

      #create-group-form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: flex-end;
      }

      .inline-label {
        display: grid;
        gap: 0.25rem;
        font-size: 0.85rem;
        flex: 1 1 12rem;
      }

      .inline-label input {
        padding: 0.5rem 0.6rem;
        border-radius: 0.5rem;
        border: 1px solid #3a4150;
        background: #1b1f28;
        color: inherit;
        font: inherit;
      }

      #ignored-invitations summary {
        cursor: pointer;
        opacity: 0.8;
        margin-bottom: 0.5rem;
      }
    </style>
  </body>
</html>
