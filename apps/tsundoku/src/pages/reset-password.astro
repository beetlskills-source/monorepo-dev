---
export const prerender = false;

const token = Astro.url.searchParams.get("token") ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Reset password — Tsundoku</title>
  </head>
  <body data-token={token}>
    <main class="app">
      <h1>Reset your password</h1>

      {
        token ? (
          <section class="panel">
            <form id="reset-form">
              <label for="password-input">
                New password
                <input
                  id="password-input"
                  name="password"
                  type="password"
                  autocomplete="new-password"
                  minlength={8}
                  required
                />
              </label>
              <label for="confirm-input">
                Confirm password
                <input
                  id="confirm-input"
                  name="confirm"
                  type="password"
                  autocomplete="new-password"
                  minlength={8}
                  required
                />
              </label>
              <button type="submit" id="submit-button">Update password</button>
            </form>
          </section>
        ) : (
          <p class="status" data-tone="error">
            This reset link is missing its token. Request a new link from the{" "}
            <a href="/login">sign-in page</a>.
          </p>
        )
      }

      <p id="status" class="status" role="status" data-tone="info" hidden></p>
      <p class="back"><a href="/login">← Back to sign in</a></p>
    </main>

    {
      token && (
        <script>
          import { createAuthClient } from "better-auth/client";

          const authClient = createAuthClient();
          const token = document.body.dataset.token || "";

          const form = document.getElementById("reset-form") as HTMLFormElement | null;
          const passwordInput = document.getElementById("password-input") as HTMLInputElement | null;
          const confirmInput = document.getElementById("confirm-input") as HTMLInputElement | null;
          const submitButton = document.getElementById("submit-button") as HTMLButtonElement | null;
          const statusEl = document.getElementById("status") as HTMLParagraphElement | null;

          function setStatus(message: string, tone = "info"): void {
            if (!statusEl) return;
            statusEl.hidden = message === "";
            statusEl.textContent = message;
            statusEl.dataset.tone = tone;
          }

          form?.addEventListener("submit", (event) => {
            event.preventDefault();
            const newPassword = passwordInput?.value ?? "";
            const confirm = confirmInput?.value ?? "";

            if (newPassword.length < 8) {
              setStatus("Passwords must be at least 8 characters.", "warning");
              return;
            }
            if (newPassword !== confirm) {
              setStatus("The two passwords do not match.", "warning");
              return;
            }

            if (submitButton) submitButton.disabled = true;
            setStatus("Updating…", "info");

            void authClient
              .resetPassword({ newPassword, token })
              .then(({ error }) => {
                if (error) {
                  if (submitButton) submitButton.disabled = false;
                  setStatus(
                    error.message || "That reset link is invalid or has expired.",
                    "error",
                  );
                  return;
                }
                setStatus("Password updated. Redirecting to sign in…", "success");
                window.location.href = "/login";
              });
          });
        </script>
      )
    }

    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, sans-serif;
      }

      body {
        margin: 0;
        background: #0f1115;
        color: #f5f6f8;
      }

      .app {
        max-width: 26rem;
        margin: 0 auto;
        padding: 1.5rem;
        display: grid;
        gap: 1rem;
      }

      h1 {
        margin: 0;
        font-size: 1.5rem;
      }

      .panel {
        border: 1px solid #2a2f3a;
        border-radius: 0.75rem;
        padding: 1rem;
      }

      form {
        display: grid;
        gap: 0.75rem;
      }

      label {
        display: grid;
        gap: 0.35rem;
        font-size: 0.85rem;
        opacity: 0.85;
      }

      input {
        padding: 0.6rem 0.9rem;
        border-radius: 0.5rem;
        border: 1px solid #3a4150;
        background: #1b1f28;
        color: inherit;
        font: inherit;
      }

      button {
        padding: 0.6rem 0.9rem;
        border-radius: 0.5rem;
        border: 1px solid #3a4150;
        background: #1b1f28;
        color: inherit;
        font: inherit;
        cursor: pointer;
      }

      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .status {
        margin: 0;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        background: #1b1f28;
      }

      .status[data-tone="warning"] {
        background: #3a2f12;
      }

      .status[data-tone="error"] {
        background: #3a1618;
      }

      .status[data-tone="success"] {
        background: #12301c;
      }

      .back {
        margin: 0;
        opacity: 0.7;
      }
    </style>
  </body>
</html>
